[Unit]
Description=React App Production Server (WEB-01)
After=network.target

[Service]
Type=simple
User=weboneuser
WorkingDirectory=/home/weboneuser/homework01-app
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target