[Unit]
Description=Next.js Application Production Server
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/home/appuser/next-app
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target